{
  "name": "short-animation-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JSON の台本から短いアニメーション動画を書き出す、AI エージェント向けの最小のハーネス (Remotion + ffmpeg)",
  "license": "MIT",
  "scripts": {
    "setup": "sh scripts/setup-fonts.sh && tsx scripts/build-assets.ts",
